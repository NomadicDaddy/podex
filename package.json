{
	"name": "podex",
	"version": "0.7.1",
	"private": true,
	"author": "NomadicDaddy",
	"bugs": {
		"url": "https://github.com/NomadicDaddy/podex/issues"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/bun": "1.3.14",
		"eslint": "10.8.0",
		"eslint-plugin-perfectionist": "5.10.1",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.9.0",
		"htmx.org": "4.0.0-beta6",
		"jiti": "2.7.0",
		"prettier": "3.9.6",
		"prettier-plugin-organize-attributes": "1.0.0",
		"prettier-plugin-sort-json": "4.2.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.66.0"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"description": "Podex - PowerShell/Pode + htmx Framework for Building Web Applications",
	"license": "MIT",
	"main": "./podex.ps1",
	"packageManager": "bun@1.3.14",
	"type": "module",
	"keywords": [
		"powershell",
		"pode",
		"htmx",
		"css",
		"sqlite"
	],
	"scripts": {
		"analyze": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./tools/analyze.ps1",
		"assets:build": "bun run assets:clean && bun scripts/build-assets.ts",
		"assets:clean": "bun scripts/clean-assets.ts",
		"build": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass \"./.build.ps1\"",
		"check-deps": "bun scripts/check-dependency-versions.ts",
		"check:leak-guard": "bun ./scripts/run-bash.ts scripts/check-leak-guard.sh",
		"check:license-core": "bun scripts/check-license-core.ts",
		"check:licenses": "bun run check:license-core && bun scripts/generate-third-party-licenses.ts --check",
		"check:max-lines": "bun scripts/check-max-lines.ts",
		"check:typescript-only": "bun scripts/check-typescript-only.ts",
		"dev": "bun run stop && pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass \"./tools/serve.ps1\"",
		"format:check": "bunx prettier --check .",
		"format:pwsh:check": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./tools/format-check.ps1",
		"format": "bunx prettier --write .",
		"licenses:generate": "bun scripts/generate-third-party-licenses.ts",
		"lint": "bunx eslint . --report-unused-disable-directives --max-warnings 0",
		"lint:fix": "bun run lint --fix",
		"prepare": "(git config core.hooksPath .githooks && bun ./scripts/run-bash.ts .githooks/leak-guard-setup.sh) || true",
		"preinstall": "bun scripts/require-bun.ts",
		"qc:fix": "bun run lint:fix && bun run format && bun run smoke:qc",
		"release:check": "bun scripts/check-release.ts",
		"release:package": "bun run assets:build && bun run check:licenses && bun scripts/package-release.ts",
		"release": "bun run release:package && bun run release:check",
		"smoke:qc": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass \"./tools/smoke-qc.ps1\"",
		"smoke:qc:fast": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass \"./tools/smoke-qc.ps1\" -SkipTests",
		"start": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass \"./tools/serve.ps1\" -Background",
		"stop": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass \"./tools/stop.ps1\"",
		"test": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass \"./tools/test.ps1\"",
		"typecheck": "tsc --noEmit"
	}
}
