<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="$($data.status.code ;) Error" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>$((Get-PodeConfig).Podex.AppName ;) - $($data.status.code ;) Error</title>
		<link rel="stylesheet" type="text/css" href="/public/css/podex.css" />
		<link rel="icon" type="image/x-icon" href="/public/images/podex.ico" />
	</head>
	<body class="error-page">
		<main class="error-content">
			<h1>$($data.status.code ;) Error</h1>
			<p>An unexpected error occurred. Please try again later.</p>
		</main>
	</body>
</html>
