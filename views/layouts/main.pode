<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Podex - PowerShell/Pode + htmx Framework for Building Web Applications" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Podex - $($data.Title ;)</title>
		<link rel="stylesheet" type="text/css" href="/public/css/podex.css" />
		<link rel="icon" type="image/x-icon" href="/public/images/podex.ico" />
		<script src="/public/js/htmx.js" defer></script>
		<script src="/public/js/crudmgr.js" defer></script>
	</head>
	<body class="app-shell" hx-boost="true">
		$(Use-PodePartialView -Path 'partials/header' -Data @{ PageName = $data.PageName } ;)
		<div class="site-body">
			<main class="site-main">$(foreach($component in $data.Components) { Use-PodePartialView -Path "components/$component" -Data $data } ;)</main>
		</div>
		$(Use-PodePartialView -Path 'partials/footer' ;)
	</body>
</html>
