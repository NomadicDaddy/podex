<header>
	<nav class="sticky top-0 z-50 w-full bg-linear-to-r from-blue-600 to-purple-600 px-4 py-3 shadow-md">
		<div class="mx-auto flex max-w-(--breakpoint-lg) flex-wrap items-center justify-between gap-y-2">
			<a href="/" class="flex items-center">
				<img src="/public/images/podex.png" class="mr-3 h-8 sm:h-10" alt="Podex" />
				<span class="self-center whitespace-nowrap text-2xl font-bold text-white hover:text-yellow-300">Podex</span>
			</a>
			<ul class="flex flex-col font-medium sm:flex-row sm:gap-x-8">
				$(foreach ($page in @('Home', 'CRUDMgr')) {
					$activeLight = 'text-yellow-300'
					$inactiveLight = 'text-white/90 hover:text-white'
					$activeUnderline = 'after:absolute after:inset-x-0 after:-bottom-1 after:h-0.5 after:rounded-full after:bg-yellow-300'
					"<li>
						<a href='/$($page -eq 'Home' ? '' : $page.ToLower())' class='relative block py-2 transition-colors sm:py-0 $($data.PageName -eq $page ? $activeLight : $inactiveLight) $($data.PageName -eq $page ? $activeUnderline : '')'>
							$($page.Substring(0,1).ToUpper() + $page.Substring(1) ;)
						</a>
					</li>"
				} ;)
			</ul>
		</div>
	</nav>
</header>
