<header class="site-header">
	<nav class="site-nav" aria-label="Primary">
		<a href="/" class="brand">
			<img src="/public/images/podex.png" width="1024" height="1024" class="brand__mark" alt="" />
			<span class="brand__name">Podex</span>
		</a>
		<ul class="site-nav__links">
			$(foreach ($page in @('Home', 'CRUDMgr')) {
				$isActive = $data.PageName -eq $page
				$className = if ($isActive) { 'site-nav__link site-nav__link--active' } else { 'site-nav__link' }
				$currentAttribute = if ($isActive) { ' aria-current="page"' } else { '' }
				"<li>
					<a href='/$($page -eq 'Home' ? '' : $page.ToLower())' class='$className'$currentAttribute>
						$($page.Substring(0,1).ToUpper() + $page.Substring(1) ;)
					</a>
				</li>"
			} ;)
		</ul>
	</nav>
</header>
