<section class="page-section">
	<div class="panel">
		<header class="page-heading page-heading--compact">
			<p class="page-eyebrow">Reference application</p>
			<h1>CRUD Manager</h1>
			<p class="page-lede">Create, update, search, and delete items without leaving the page.</p>
		</header>
		<div id="crud-list" aria-live="polite" aria-atomic="false">
			$(Use-PodePartialView -Path 'components/crud-list' -Data $data ;)
		</div>
	</div>
</section>

<div id="loading" class="htmx-indicator loading-indicator" aria-hidden="true">
	<div class="spinner" aria-hidden="true"></div>
</div>

<div
	id="itemModal"
	role="dialog"
	aria-modal="true"
	aria-labelledby="itemModalTitle"
	aria-hidden="true"
	class="modal-backdrop">
	<div id="itemModalContent" class="modal-panel">
		<!-- Modal content will be loaded here -->
	</div>
</div>
