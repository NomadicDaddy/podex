$(
	$previousAttributes = if ($data.HasPreviousPage) {
		"hx-get=`"/api/crud?page=$($data.PreviousPage)`""
	} else {
		'disabled aria-disabled="true"'
	}
	$nextAttributes = if ($data.HasNextPage) {
		"hx-get=`"/api/crud?page=$($data.NextPage)`""
	} else {
		'disabled aria-disabled="true"'
	}
;)
<div id="crud">
	<input type="hidden" id="current-page" name="page" value="$($data.CurrentPage ;)" />
	<div id="crud-error" role="alert" aria-live="assertive" class="alert"></div>
	<div class="crud-toolbar">
		<div class="search-field">
			<label for="simple-search" class="sr-only">Search</label>
			<svg aria-hidden="true" class="search-field__icon icon" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
				<path
					fill-rule="evenodd"
					d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z"
					clip-rule="evenodd" />
			</svg>
			<input
				type="search"
				id="simple-search"
				name="search"
				value="$($data.Search ;)"
				class="form-control form-control--search"
				placeholder="Search items"
				hx-trigger="keyup changed delay:500ms, search"
				hx-get="/api/crud"
				hx-target="#crud"
				hx-swap="outerMorph"
				hx-include="#current-page"
				hx-status:5xx="target:#crud-error swap:innerHTML" />
		</div>
		<button
			type="button"
			id="addItemBtn"
			class="button button--primary"
			hx-get="/htmx/item-new"
			hx-target="#itemModalContent"
			hx-swap="innerHTML"
			aria-haspopup="dialog">
			<svg class="icon icon--small" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<path clip-rule="evenodd" fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" />
			</svg>
			Add Item
		</button>
	</div>

	<div class="table-scroll">
		<table class="data-table">
			<thead>
				<tr>
					<th scope="col">ID</th>
					<th scope="col">Item</th>
					<th scope="col">Description</th>
					<th scope="col">Date Added</th>
					<th scope="col">Actions</th>
				</tr>
			</thead>
			<tbody>
				$(
					if ($data.Items.Count -eq 0) {
@"
				<tr>
					<td class="data-table__empty" colspan="5">No items found.</td>
				</tr>
"@
					} else {
						foreach ($item in $data.Items) {
@"
				<tr data-id="$($item.Id)">
					<td class="data-table__id"><input type="hidden" name="id" value="$($item.Id)" required />$($item.Id)</td>
					<td>
						<input type="text" name="item" value="$($item.Item)" maxlength="200" required aria-label="Item name $($item.Id)" class="row-input" />
					</td>
					<td>
						<input type="text" name="description" value="$($item.Description)" maxlength="2000" required aria-label="Description $($item.Id)" class="row-input" />
					</td>
					<td class="data-table__date">$($item.CreatedAtDisplay)</td>
					<td class="data-table__actions">
						<div class="data-table__action-group">
							<button
								type="button"
								class="button button--small button--warning"
								hx-put="/api/crud"
								hx-target="#crud"
								hx-swap="outerMorph"
								hx-include="closest tr, #simple-search, #current-page"
								hx-status:4xx="target:#crud-error swap:innerHTML"
								hx-status:5xx="target:#crud-error swap:innerHTML">
								Update
							</button>
							<button
								type="button"
								class="button button--small button--danger"
								hx-delete="/api/crud?id=$($item.Id)"
								hx-confirm="Are you sure you want to delete this item?"
								hx-target="#crud"
								hx-swap="outerMorph"
								hx-include="#simple-search, #current-page"
								hx-status:4xx="target:#crud-error swap:innerHTML"
								hx-status:5xx="target:#crud-error swap:innerHTML">
								Delete
							</button>
						</div>
					</td>
				</tr>
"@
						}
					}
				;)
			</tbody>
		</table>
	</div>

	<nav class="pagination-bar" aria-label="Table navigation">
		<p class="pagination-summary">
			Showing <strong>$($data.StartIndex ;)-$($data.EndIndex ;)</strong>
			of <strong>$($data.TotalItems ;)</strong>
		</p>
		<ul class="pagination">
			<li>
				<button
					type="button"
					$($previousAttributes ;)
					class="page-link page-link--previous"
					hx-target="#crud"
					hx-swap="outerMorph"
					hx-include="#simple-search"
					hx-status:5xx="target:#crud-error swap:innerHTML">
					<span class="sr-only">Previous</span>
					<svg class="icon" aria-hidden="true" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
						<path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
					</svg>
				</button>
			</li>
			$(
				foreach ($page in $data.Pages) {
					$activeClass = if ($page.IsActive) { ' page-link--active' } else { '' }
					$currentAttribute = if ($page.IsActive) { 'aria-current="page"' } else { '' }
@"
			<li>
				<button
					type="button"
					class="page-link$activeClass"
					$currentAttribute
					hx-get="/api/crud?page=$($page.Number)"
					hx-target="#crud"
					hx-swap="outerMorph"
					hx-include="#simple-search"
					hx-status:5xx="target:#crud-error swap:innerHTML">
					$($page.Number)
				</button>
			</li>
"@
				}
			;)
			<li>
				<button
					type="button"
					$($nextAttributes ;)
					class="page-link page-link--next"
					hx-target="#crud"
					hx-swap="outerMorph"
					hx-include="#simple-search"
					hx-status:5xx="target:#crud-error swap:innerHTML">
					<span class="sr-only">Next</span>
					<svg class="icon" aria-hidden="true" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
						<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
					</svg>
				</button>
			</li>
		</ul>
	</nav>
</div>
