<div class="modal-card">
	<header class="modal-header">
		<h2 id="itemModalTitle" class="modal-title">Add New Item</h2>
		<button type="button" class="icon-button" aria-label="Close add item dialog" data-close-modal>
			<svg class="icon" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<path
					fill-rule="evenodd"
					d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
					clip-rule="evenodd"></path>
			</svg>
		</button>
	</header>
	<form
		hx-post="/api/crud"
		hx-target="#crud"
		hx-swap="outerMorph"
		hx-include="#simple-search, #current-page"
		hx-status:4xx="target:#itemModalError swap:innerHTML"
		hx-status:5xx="target:#itemModalError swap:innerHTML">
		<div class="modal-fields">
			<div id="itemModalError" role="alert" aria-live="polite" class="alert"></div>
			<div class="form-field">
				<label for="item" class="form-label">Item Name</label>
				<input
					type="text"
					name="item"
					id="item"
					maxlength="200"
					class="form-control"
					placeholder="Enter item name"
					required />
			</div>
			<div class="form-field">
				<label for="description" class="form-label">Item Description</label>
				<textarea
					name="description"
					id="description"
					maxlength="2000"
					class="form-control"
					placeholder="Enter description in markdown or HTML format"
					required></textarea>
			</div>
		</div>
		<footer class="modal-actions">
			<button type="submit" class="button button--primary">Add Item</button>
			<button type="button" class="button button--secondary" data-close-modal>Cancel</button>
		</footer>
	</form>
</div>
